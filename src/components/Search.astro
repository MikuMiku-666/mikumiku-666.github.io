---
import { getNotes, getProjects } from '../lib/content';
import { entryUrl } from '../lib/urls';
import Icon from './Icon.astro';
const [notes, projects] = await Promise.all([getNotes(), getProjects()]);
const entries = [
  ...notes.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    type: '笔记',
    tags: entry.data.tags,
    body: entry.body,
    href: entryUrl('notes', entry.id),
  })),
  ...projects.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    type: '项目',
    tags: entry.data.stack,
    body: entry.body,
    href: entryUrl('projects', entry.id),
  })),
];
---

<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
  <div class="search-dialog-header">
    <h2 id="search-title">在这里，找到一点灵感</h2>
    <button class="icon-button" data-close-search aria-label="关闭搜索">
      <Icon name="close" />
    </button>
  </div>
  <label class="search-field">
    <Icon name="search" />
    <input
      id="global-search"
      type="search"
      placeholder="搜索文章、项目、关键词…"
      aria-label="搜索文章、项目、关键词"
      autocomplete="off"
    />
  </label>
  <p id="search-count" class="search-count" role="status"></p>
  <div id="search-results" class="search-results"></div>
  <div class="search-dialog-footer">
    <span>文字与作品，都在这里</span>
    <span>
      <kbd>Esc</kbd> 关闭
    </span>
  </div>
</dialog>
<script
  id="search-data"
  type="application/json"
  set:html={JSON.stringify(entries).replaceAll('<', '\\u003c')}
/>
<script>
  type Entry = {
    title: string;
    description: string;
    type: string;
    tags: string[];
    body?: string;
    href: string;
  };
  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog')!;
  const input = document.querySelector<HTMLInputElement>('#global-search')!;
  const results = document.querySelector<HTMLElement>('#search-results')!;
  const count = document.querySelector<HTMLElement>('#search-count')!;
  const entries: Entry[] = JSON.parse(document.querySelector('#search-data')!.textContent || '[]');
  function renderResults() {
    const terms = input.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    const matches = entries.filter((entry) => {
      const haystack =
        `${entry.title} ${entry.description} ${entry.tags.join(' ')} ${entry.body || ''}`.toLocaleLowerCase();
      return terms.every((term) => haystack.includes(term));
    });
    results.replaceChildren();
    count.textContent = terms.length ? `找到 ${matches.length} 条结果` : '随意翻翻，或输入关键词';
    for (const entry of matches) {
      const anchor = document.createElement('a');
      anchor.href = entry.href;
      const type = document.createElement('span');
      type.className = 'result-type';
      type.textContent = entry.type;
      const title = document.createElement('strong');
      title.textContent = entry.title;
      const description = document.createElement('p');
      description.textContent = entry.description;
      anchor.append(type, title, description);
      results.append(anchor);
    }
    if (!matches.length) {
      const empty = document.createElement('p');
      empty.className = 'empty-state';
      empty.textContent = '还没有相关内容，换一个关键词试试。';
      results.append(empty);
    }
  }
  function openSearch() {
    if (!dialog.open) dialog.showModal();
    renderResults();
    input.focus();
  }
  document
    .querySelectorAll('[data-open-search]')
    .forEach((button) => button.addEventListener('click', openSearch));
  document.querySelector('[data-close-search]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) {
      const bounds = dialog.getBoundingClientRect();
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      )
        dialog.close();
    }
  });
  input.addEventListener('input', renderResults);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') results.querySelector<HTMLAnchorElement>('a')?.click();
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
  });
</script>
