---
import type { CollectionEntry } from 'astro:content';
import { entryUrl } from '../lib/urls';
import { formatDate, readingTime } from '../lib/content';
import Icon from './Icon.astro';
interface Props {
  note: CollectionEntry<'notes'>;
  index?: number;
}
const { note, index = 0 } = Astro.props;
---

<a class="note-row" href={entryUrl('notes', note.id)}>
  <span class="note-index" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </span>
  <div class="note-content">
    <div class="note-meta">
      <span
        class:list={[
          'category-label',
          {
            pink: note.data.category === '写作与表达',
            blue: note.data.category === '动手实践',
            peach: note.data.category === '学习方法',
          },
        ]}
      >
        {note.data.category}
      </span>
      <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
      {note.data.demo && <span class="demo-label">示例</span>}
    </div>
    <h3>{note.data.title}</h3>
    <p>{note.data.description}</p>
    <div class="note-tags">
      {note.data.tags.map((tag) => (
        <span>#{tag}</span>
      ))}
      <span class="reading-time">{readingTime(note.body)} 分钟阅读</span>
    </div>
  </div>
  <span class="row-arrow">
    <Icon name="external" size={22} />
  </span>
</a>
