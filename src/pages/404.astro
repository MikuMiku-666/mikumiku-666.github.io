---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/urls';
---

<BaseLayout title="这一页还在留白" noindex>
  <section class="not-found container">
    <div class="eyebrow">A LITTLE DETOUR</div>
    <div class="error-code">
      4<span>✳</span>4
    </div>
    <h1>这一页，还在留白。</h1>
    <p>
      可能是地址写错了，也可能是内容搬了家。
      <br />
      回到熟悉的地方，再随意翻翻吧。
    </p>
    <a class="button button-primary" href={url('/')}>
      回到首页 ↗
    </a>
    <a class="text-link" href={url('/notes/')}>
      看看笔记 →
    </a>
  </section>
</BaseLayout>
